{
  "name": "skyfolio",
  "private": true,
  "version": "0.1.0",
  "description": "SKYFOLIO — portofolio 3D interaktif Syahril Maimubdy (Aril): biplane berfisika nyata mengelilingi Bumi low-poly.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prebuild": "npm run validate:content && npm run build:knowledge && npm run optimize:media && npm run sync:github",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json --threshold warning --fail-on-warnings",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --config playwright.config.ts",
    "shots": "playwright test --config playwright.shots.config.ts",
    "build:earth": "tsx scripts/build-earth.ts",
    "sync:github": "tsx scripts/sync-github.ts",
    "ingest:certificates": "tsx scripts/ingest-certificates.ts",
    "optimize:media": "tsx scripts/optimize-media.ts",
    "build:cv": "tsx scripts/build-cv.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "build:knowledge": "tsx scripts/build-knowledge.ts",
    "perf": "playwright test --config playwright.perf.config.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@fontsource/fredoka": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "howler": "2.2.4",
    "lil-gui": "0.21.0",
    "suncalc": "2.1.3",
    "svelte": "5.57.3",
    "three": "0.187.0",
    "three-mesh-bvh": "0.9.18",
    "tone": "15.1.22",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/geojson": "7946.0.16",
    "@types/howler": "2.2.13",
    "@types/node": "22.20.5",
    "@types/suncalc": "1.9.2",
    "@types/three": "0.187.0",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.24.1",
    "globals": "17.14.0",
    "pdfjs-dist": "6.5.438",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "sharp": "0.35.5",
    "svelte-check": "4.7.8",
    "svelte-eslint-parser": "1.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
